# Copy to .env (never committed). Without the three LLM settings Inventra runs in keyless mode.
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=            # a model ID from OpenRouter's model list, e.g. google/gemini-2.5-flash
# LLM_FALLBACK_MODELS=  # optional, comma-separated: OpenRouter tries these if LLM_MODEL is rate-limited or down
LLM_TIMEOUT_SECONDS=15

# Single planner login (design doc section 15): every action is attributed to this user.
PLANNER_USER=planner

# Browser origins allowed to call the API (the frontend). A browser write (POST/PATCH) from any other origin is refused.
CORS_ORIGINS=http://localhost:3000
# Host names the API answers to (blocks DNS rebinding). Add a name here only if you reach the API by it.
# ALLOWED_HOSTS=127.0.0.1,localhost

# Watcher: files dropped into INBOX_DIR are validated, loaded and re-planned automatically.
WATCHER_ENABLED=1
# INBOX_DIR=./runtime/inbox
# RUNTIME_DIR=./runtime          # DuckDB file, inbox, archive, quarantine
# ANSWER_KEY_DIR=./data/judges/answer_key   # read only by the evaluation replay

MAX_UPLOAD_BYTES=5242880
MAX_UPLOAD_ROWS=50000

# Agents. The watcher agent investigates the cells a loaded file made worse (background, never approves).
AGENT_WATCH_ENABLED=1
# AGENT_WATCH_CELLS=2            # cells investigated per loaded file
# AGENT_MAX_STEPS=10             # tool calls per LLM run
